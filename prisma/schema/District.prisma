model District {
    id        String   @id @default(uuid())
    name      String   @unique
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    divisionId String
    division   Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)

    createdById String?
    createdBy   User?   @relation("DistrictCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

    updatedById String?
    updatedBy   User?   @relation("DistrictUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

    cities City[]

    @@index([divisionId])
    @@map("districts")
}
