model Parcel {
    id         String @id @default(uuid())
    trackingId String @unique

    pickupContactName  String
    pickupContactPhone String
    pickupAddressLine  String
    pickupMode         PickupMode @default(RIDER_PICKUP)
    pickupDistrict     String
    pickupCity         String
    note               String?

    recipientName       String
    recipientPhone      String
    recipientEmail      String
    deliveryAddressLine String
    deliveryDistrict    String
    deliveryCity        String

    parcelCategory  ParcelCategory
    weightKg        Decimal        @db.Decimal(10, 2)
    itemDescription String
    itemQuantity    Int            @default(1)
    declaredValue   Decimal?       @db.Decimal(12, 2)
    deliveryType    DeliveryType   @default(REGULAR)
    paymentType     PaymentType
    codAmount       Decimal?       @db.Decimal(12, 2)

    deliveryZoneType      ZoneType
    baseCharge            Decimal  @db.Decimal(12, 2)
    weightCharge          Decimal  @db.Decimal(12, 2)
    deliveryTypeSurcharge Decimal  @db.Decimal(12, 2)
    pickupModeCharge      Decimal  @default(0) @db.Decimal(12, 2)
    codFee                Decimal  @default(0) @db.Decimal(12, 2)
    totalCharge           Decimal  @db.Decimal(12, 2)

    status         ParcelStatus @default(CREATED)
    reattemptCount Int          @default(0)
    maxReattempts  Int          @default(3)

    cancelledAt   DateTime?
    cancelledById String?
    cancelReason  String?
    failureReason String?

    deliveredAt DateTime?
    returnedAt  DateTime?

    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    merchantId String
    merchant   MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    transaction Transaction?
    assignments Assignment[]

    @@index([merchantId, status])
    @@index([status])
    @@index([deliveryDistrict])
    @@map("parcels")
}
