model Transaction {
    id String @id @default(uuid())

    amount Decimal @db.Decimal(12, 2)

    status   TransactionStatus @default(PENDING)
    currency String            @default("BDT")

    paymentGateway        String @default("bkash")
    merchantInvoiceNumber String @unique

    bkashPaymentID String? @unique
    bkashTrxID     String?
    payerReference String?
    paidAt         String?

    bkashResponse Json?

    refundedAmount Decimal? @db.Decimal(12, 2)
    refundedAt     String?
    refundReason   String?
    refundTxID     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    parcelId String @unique
    parcel   Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([createdAt])
    @@map("transactions")
}
