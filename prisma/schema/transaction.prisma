model Transaction {
    id String @id @default(uuid())

    amount Decimal @db.Decimal(12, 2)

    status   TransactionStatus @default(PENDING)
    currency String            @default("BDT")

    bookingPayload Json?

    paymentGateway        String @default("bkash")
    merchantInvoiceNumber String @unique

    bkashPaymentID String? @unique
    bkashTrxID     String?
    bkashStatus    String?
    payerReference String?
    paidAt         String?

    bkashResponse Json?

    refundedAmount Decimal?  @db.Decimal(12, 2)
    refundedAt     String?
    refundReason   String?
    refundTxID     String?

    expiresAt DateTime? 
    failedAt  DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    merchantId String
    merchant   MerchantProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    parcelId String? @unique
    parcel   Parcel? @relation(fields: [parcelId], references: [id])

    @@index([merchantId, status])
    @@index([status, expiresAt])
    @@index([createdAt])
    @@map("transactions")
}
