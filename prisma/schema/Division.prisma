model Division {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("DivisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updatedById String?
  updatedBy   User?   @relation("DivisionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  districts District[]

  @@map("divisions")
}