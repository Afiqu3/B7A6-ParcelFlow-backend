model PricingRule {
    id             String         @id @default(uuid())
    name           String         @unique
    zoneType       ZoneType
    parcelCategory ParcelCategory

    baseWeightKg Decimal @default(1.00) @db.Decimal(10, 2)
    baseCharge   Decimal @db.Decimal(12, 2)
    perKgCharge  Decimal @db.Decimal(12, 2)

    expressSurcharge Decimal @default(0) @db.Decimal(12, 2)
    sameDaySurcharge Decimal @default(0) @db.Decimal(12, 2)

    riderPickupCharge Decimal @default(0) @db.Decimal(12, 2)

    codFeePercent Decimal @default(0) @db.Decimal(5, 2)

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([zoneType, parcelCategory])
    @@index([zoneType, parcelCategory, isActive])
    @@map("pricing_rules")
}
