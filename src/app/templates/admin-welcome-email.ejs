<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Access Granted – ParcelFlow</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700&display=swap');

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #EEF2F7;
            font-family: 'Inter', Arial, sans-serif;
            color: #1A2340;
            -webkit-font-smoothing: antialiased;
        }

        .wrapper {
            max-width: 560px;
            margin: 48px auto;
            padding: 0 16px 48px;
        }

        .header {
            background: #0F2057;
            border-radius: 12px 12px 0 0;
            padding: 28px 40px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-mark {
            width: 36px;
            height: 36px;
            background: #3B82F6;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-mark svg {
            width: 20px;
            height: 20px;
            fill: #fff;
        }

        .logo-text {
            font-family: 'Sora', sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            letter-spacing: -0.3px;
        }

        .logo-text span {
            color: #60A5FA;
        }

        /* ── Hero (amber/gold) ── */
        .hero {
            background: linear-gradient(135deg, #78350F 0%, #92400E 50%, #B45309 100%);
            padding: 44px 40px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -55px;
            right: -55px;
            width: 220px;
            height: 220px;
            background: rgba(251, 191, 36, 0.12);
            border-radius: 50%;
        }

        .hero::after {
            content: '';
            position: absolute;
            bottom: -40px;
            left: -40px;
            width: 155px;
            height: 155px;
            background: rgba(252, 211, 77, 0.08);
            border-radius: 50%;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(251, 191, 36, 0.2);
            border: 1px solid rgba(252, 211, 77, 0.4);
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 12px;
            font-weight: 600;
            color: #FCD34D;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            position: relative;
            z-index: 1;
            margin-bottom: 12px;
        }

        .hero-badge svg {
            width: 12px;
            height: 12px;
            fill: #FCD34D;
        }

        .hero-icon-ring {
            width: 72px;
            height: 72px;
            background: rgba(251, 191, 36, 0.18);
            border: 2px solid rgba(252, 211, 77, 0.38);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            position: relative;
            z-index: 1;
        }

        .hero-icon-ring svg {
            width: 34px;
            height: 34px;
            fill: #FCD34D;
        }

        .hero-title {
            font-family: 'Sora', sans-serif;
            font-size: 25px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 10px;
            position: relative;
            z-index: 1;
        }

        .hero-sub {
            font-size: 14px;
            color: #FDE68A;
            line-height: 1.6;
            position: relative;
            z-index: 1;
        }

        /* ── Card ── */
        .card {
            background: #fff;
            padding: 42px 40px 36px;
        }

        .greeting {
            font-family: 'Sora', sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #0F2057;
            margin-bottom: 10px;
        }

        .intro {
            font-size: 14.5px;
            line-height: 1.7;
            color: #4A5578;
            margin-bottom: 28px;
        }

        /* ── Credentials ── */
        .cred-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #8A94B2;
            margin-bottom: 12px;
        }

        .cred-box {
            background: #FFFBEB;
            border: 1.5px solid #FDE68A;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 10px;
        }

        .cred-row {
            display: flex;
            align-items: stretch;
            border-bottom: 1px solid #FEF3C7;
        }

        .cred-row:last-child {
            border-bottom: none;
        }

        .cred-key {
            width: 110px;
            flex-shrink: 0;
            background: #FEF3C7;
            padding: 13px 14px;
            font-size: 11.5px;
            font-weight: 600;
            color: #92400E;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .cred-key svg {
            width: 13px;
            height: 13px;
            fill: #B45309;
            flex-shrink: 0;
        }

        .cred-val {
            padding: 13px 16px;
            font-size: 13.5px;
            color: #1A2340;
            font-family: 'Courier New', monospace;
            font-weight: 600;
            word-break: break-all;
        }

        .cred-note {
            font-size: 12px;
            color: #B45309;
            margin-bottom: 28px;
            display: flex;
            align-items: flex-start;
            gap: 6px;
            line-height: 1.55;
        }

        .cred-note svg {
            width: 14px;
            height: 14px;
            fill: #B45309;
            flex-shrink: 0;
            margin-top: 1px;
        }

        /* ── Privileges ── */
        .priv-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #8A94B2;
            margin-bottom: 14px;
        }

        .priv-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 32px;
        }

        .priv-item {
            display: flex;
            align-items: center;
            gap: 9px;
            background: #F8FAFF;
            border: 1px solid #E4ECFF;
            border-radius: 8px;
            padding: 11px 13px;
        }

        .priv-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .priv-text {
            font-size: 12.5px;
            font-weight: 500;
            color: #3A4D7A;
        }

        /* ── CTA ── */
        .cta-wrap {
            text-align: center;
            margin-bottom: 32px;
        }

        .cta-btn {
            display: inline-block;
            background: #0F2057;
            color: #ffffff !important;
            font-family: 'Sora', sans-serif;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            padding: 14px 36px;
            border-radius: 8px;
            letter-spacing: 0.2px;
        }

        .divider {
            border: none;
            border-top: 1px solid #E8EDF5;
            margin: 0 0 26px;
        }

        /* ── Warning ── */
        .warning-row {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            background: #FFF8F5;
            border-left: 3px solid #E05C2A;
            border-radius: 0 8px 8px 0;
            padding: 14px 16px;
            margin-bottom: 20px;
        }

        .warning-icon {
            flex-shrink: 0;
            margin-top: 1px;
        }

        .warning-text {
            font-size: 13px;
            line-height: 1.6;
            color: #5A3820;
        }

        .warning-text strong {
            display: block;
            font-weight: 600;
            color: #3B1F0F;
            margin-bottom: 2px;
        }

        .help-note {
            font-size: 13px;
            color: #8A94B2;
            line-height: 1.6;
        }

        .help-note a {
            color: #3B82F6;
            text-decoration: none;
        }

        /* ── Footer ── */
        .footer {
            background: #F5F7FC;
            border-radius: 0 0 12px 12px;
            padding: 24px 40px;
            border-top: 1px solid #E2E8F5;
            text-align: center;
        }

        .footer-text {
            font-size: 12px;
            color: #8A94B2;
            line-height: 1.7;
        }

        .footer-brand {
            font-weight: 600;
            color: #0F2057;
        }

        @media (max-width: 480px) {
            .wrapper {
                margin: 16px auto;
            }

            .header,
            .card,
            .footer {
                padding-left: 24px;
                padding-right: 24px;
            }

            .hero {
                padding: 32px 24px;
            }

            .hero-title {
                font-size: 20px;
            }

            .priv-grid {
                grid-template-columns: 1fr;
            }

            .cred-key {
                width: 90px;
            }
        }
    </style>
</head>

<body>
    <div class="wrapper">

        <!-- Header -->
        <div class="header">
            <div class="logo-mark">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-1.5 1.5L20.46 12H17V9.5h1.5zM6 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2.22-3c-.55-.61-1.33-1-2.22-1s-1.67.39-2.22 1H3V6h12v9H8.22zm9.78 3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z" />
                </svg>
            </div>
            <span class="logo-text">Parcel<span>Flow</span></span>
        </div>

        <!-- Hero -->
        <div class="hero">
            <div class="hero-badge">
                <svg viewBox="0 0 24 24">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
                </svg>
                Admin Access
            </div>
            <div class="hero-icon-ring">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                </svg>
            </div>
            <h1 class="hero-title">Admin Access Granted</h1>
            <p class="hero-sub">
                You have been granted administrator privileges<br />
                on the ParcelFlow platform.
            </p>
        </div>

        <!-- Card -->
        <div class="card">
            <p class="greeting">Welcome, <%= name %>!</p>
            <p class="intro">
                A ParcelFlow administrator account has been created for you. Your login
                credentials are listed below. You will be required to change your password
                on first login — keep these credentials confidential and do not share them
                with anyone.
            </p>

            <p class="cred-label">Your login credentials</p>
            <div class="cred-box">
                <div class="cred-row">
                    <div class="cred-key">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z" />
                        </svg>
                        Email
                    </div>
                    <div class="cred-val">
                        <%= email %>
                    </div>
                </div>
                <div class="cred-row">
                    <div class="cred-key">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                        </svg>
                        Password
                    </div>
                    <div class="cred-val">
                        <%= password %>
                    </div>
                </div>
                <div class="cred-row">
                    <div class="cred-key">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
                        </svg>
                        Role
                    </div>
                    <div class="cred-val">
                        <%= role %>
                    </div>
                </div>
            </div>
            <p class="cred-note">
                <svg viewBox="0 0 24 24">
                    <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
                </svg>
                You must change this temporary password immediately after your first login.
            </p>

            <p class="priv-label">Your access privileges</p>
            <div class="priv-grid">
                <div class="priv-item">
                    <div class="priv-dot" style="background:#3B82F6;"></div>
                    <span class="priv-text">Manage Merchants</span>
                </div>
                <div class="priv-item">
                    <div class="priv-dot" style="background:#10B981;"></div>
                    <span class="priv-text">Manage Riders</span>
                </div>
                <div class="priv-item">
                    <div class="priv-dot" style="background:#8B5CF6;"></div>
                    <span class="priv-text">View All Parcels</span>
                </div>
                <div class="priv-item">
                    <div class="priv-dot" style="background:#F59E0B;"></div>
                    <span class="priv-text">COD Settlements</span>
                </div>
                <div class="priv-item">
                    <div class="priv-dot" style="background:#EF4444;"></div>
                    <span class="priv-text">System Reports</span>
                </div>
                <div class="priv-item">
                    <div class="priv-dot" style="background:#0EA5E9;"></div>
                    <span class="priv-text">Support Management</span>
                </div>
            </div>

            <div class="cta-wrap">
                <a href="https://parcelflow.com/admin/login" class="cta-btn">Access Admin Panel →</a>
            </div>

            <hr class="divider" />

            <div class="warning-row">
                <span class="warning-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="#E05C2A">
                        <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
                    </svg>
                </span>
                <div class="warning-text">
                    <strong>Keep these credentials private</strong>
                    Never share your admin login details with anyone, including ParcelFlow
                    staff. All actions performed under this account are logged and audited.
                </div>
            </div>

            <p class="help-note">
                Need help? Contact the system owner or reach us at
                <a href="mailto:support@parcelflow.com">support@parcelflow.com</a>.
            </p>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p class="footer-text">
                © <%= new Date().getFullYear() %> <span class="footer-brand">ParcelFlow</span>. All rights
                    reserved.<br />
                    This is an automated message. Please do not reply to this email.<br />
                    <a href="https://parcelflow.com/privacy" style="color:#8A94B2; text-decoration:underline;">Privacy
                        Policy</a>
                    &nbsp;·&nbsp;
                    <a href="https://parcelflow.com/help" style="color:#8A94B2; text-decoration:underline;">Help
                        Center</a>
            </p>
        </div>

    </div>
</body>

</html>