<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify your email – ParcelFlow</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700&display=swap');

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #EEF2F7;
            font-family: 'Inter', Arial, sans-serif;
            color: #1A2340;
            -webkit-font-smoothing: antialiased;
        }

        .wrapper {
            max-width: 560px;
            margin: 48px auto;
            padding: 0 16px 48px;
        }

        .header {
            background: #0F2057;
            border-radius: 12px 12px 0 0;
            padding: 28px 40px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-mark {
            width: 36px;
            height: 36px;
            background: #3B82F6;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-mark svg {
            width: 20px;
            height: 20px;
            fill: #fff;
        }

        .logo-text {
            font-family: 'Sora', sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.3px;
        }

        .logo-text span {
            color: #60A5FA;
        }

        .card {
            background: #ffffff;
            padding: 44px 40px 36px;
        }

        .greeting {
            font-family: 'Sora', sans-serif;
            font-size: 22px;
            font-weight: 700;
            color: #0F2057;
            margin-bottom: 12px;
            line-height: 1.3;
        }

        .intro {
            font-size: 15px;
            line-height: 1.65;
            color: #4A5578;
            margin-bottom: 36px;
            max-width: 44ch;
        }

        .otp-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #8A94B2;
            margin-bottom: 10px;
        }

        .otp-box {
            background: #F0F5FF;
            border: 1.5px solid #C7D9FF;
            border-radius: 10px;
            padding: 20px 28px;
            margin-bottom: 10px;
            display: inline-block;
        }

        .otp-code {
            font-family: 'Sora', monospace;
            font-size: 38px;
            font-weight: 700;
            letter-spacing: 10px;
            color: #0F2057;
            line-height: 1;
        }

        .otp-expiry {
            font-size: 13px;
            color: #8A94B2;
            margin-bottom: 36px;
        }

        .otp-expiry strong {
            color: #E05C2A;
            font-weight: 600;
        }

        .divider {
            border: none;
            border-top: 1px solid #E8EDF5;
            margin: 32px 0;
        }

        .security-row {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            background: #FFF8F5;
            border-left: 3px solid #E05C2A;
            border-radius: 0 8px 8px 0;
            padding: 14px 16px;
            margin-bottom: 32px;
        }

        .security-icon {
            flex-shrink: 0;
            margin-top: 1px;
        }

        .security-text {
            font-size: 13px;
            line-height: 1.6;
            color: #5A3820;
        }

        .security-text strong {
            display: block;
            font-weight: 600;
            margin-bottom: 2px;
            color: #3B1F0F;
        }

        .footer {
            background: #F5F7FC;
            border-radius: 0 0 12px 12px;
            padding: 24px 40px;
            border-top: 1px solid #E2E8F5;
        }

        .footer-text {
            font-size: 12.5px;
            color: #8A94B2;
            line-height: 1.6;
            text-align: center;
        }

        .footer-brand {
            font-weight: 600;
            color: #0F2057;
        }

        @media (max-width: 480px) {
            .wrapper {
                margin: 16px auto;
            }

            .header,
            .card,
            .footer {
                padding-left: 24px;
                padding-right: 24px;
            }

            .otp-code {
                font-size: 30px;
                letter-spacing: 7px;
            }

            .greeting {
                font-size: 19px;
            }
        }
    </style>
</head>

<body>
    <div class="wrapper">

        <!-- Header -->
        <div class="header">
            <div class="logo-mark">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-1.5 1.5L20.46 12H17V9.5h1.5zM6 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2.22-3c-.55-.61-1.33-1-2.22-1s-1.67.39-2.22 1H3V6h12v9H8.22zm9.78 3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z" />
                </svg>
            </div>
            <span class="logo-text">Parcel<span>Flow</span></span>
        </div>

        <!-- Card -->
        <div class="card">
            <p class="greeting">Verify your email, <%= name %>
            </p>
            <p class="intro">
                You're one step away from joining ParcelFlow. Use the code below
                to confirm your email address and activate your merchant account.
            </p>

            <p class="otp-label">Your verification code</p>
            <div class="otp-box">
                <div class="otp-code">
                    <%= otp %>
                </div>
            </div>
            <p class="otp-expiry">
                This code expires in <strong>
                    <%= expirationMinutes %> minutes
                </strong>.
                Do not share it with anyone.
            </p>

            <div class="security-row">
                <span class="security-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" fill="#E05C2A"
                            opacity="0.2" />
                        <path
                            d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 13l-3-3 1.41-1.41L11 11.17l4.59-4.58L17 8l-6 6z"
                            fill="#E05C2A" />
                    </svg>
                </span>
                <div class="security-text">
                    <strong>Didn't request this?</strong>
                    If you didn't create a ParcelFlow account, you can safely ignore
                    this email. Someone may have entered your address by mistake.
                </div>
            </div>

            <hr class="divider" />

            <p style="font-size:13px; color:#8A94B2; line-height:1.6;">
                This code was sent to <strong style="color:#1A2340;">
                    <%= email %>
                </strong>.<br />
            </p>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p class="footer-text">
                © <%= new Date().getFullYear() %> <span class="footer-brand">ParcelFlow</span>.
                    All rights reserved.<br />
                    Connecting merchants and riders across Bangladesh.
            </p>
        </div>

    </div>
</body>

</html>