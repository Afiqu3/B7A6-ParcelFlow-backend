<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Changed – ParcelFlow</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700&display=swap');

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #EEF2F7;
            font-family: 'Inter', Arial, sans-serif;
            color: #1A2340;
            -webkit-font-smoothing: antialiased;
        }

        .wrapper {
            max-width: 560px;
            margin: 48px auto;
            padding: 0 16px 48px;
        }

        .header {
            background: #0F2057;
            border-radius: 12px 12px 0 0;
            padding: 28px 40px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-mark {
            width: 36px;
            height: 36px;
            background: #3B82F6;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-mark svg {
            width: 20px;
            height: 20px;
            fill: #fff;
        }

        .logo-text {
            font-family: 'Sora', sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            letter-spacing: -0.3px;
        }

        .logo-text span {
            color: #60A5FA;
        }

        /* ── Hero (green) ── */
        .hero {
            background: linear-gradient(135deg, #065F46 0%, #047857 50%, #059669 100%);
            padding: 44px 40px 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 210px;
            height: 210px;
            background: rgba(16, 185, 129, 0.15);
            border-radius: 50%;
        }

        .hero::after {
            content: '';
            position: absolute;
            bottom: -40px;
            left: -40px;
            width: 150px;
            height: 150px;
            background: rgba(52, 211, 153, 0.1);
            border-radius: 50%;
        }

        .hero-icon-ring {
            width: 72px;
            height: 72px;
            background: rgba(16, 185, 129, 0.2);
            border: 2px solid rgba(52, 211, 153, 0.4);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            position: relative;
            z-index: 1;
        }

        .hero-icon-ring svg {
            width: 34px;
            height: 34px;
            fill: #6EE7B7;
        }

        .hero-title {
            font-family: 'Sora', sans-serif;
            font-size: 25px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 10px;
            position: relative;
            z-index: 1;
        }

        .hero-sub {
            font-size: 14px;
            color: #A7F3D0;
            line-height: 1.6;
            position: relative;
            z-index: 1;
        }

        /* ── Card ── */
        .card {
            background: #fff;
            padding: 42px 40px 36px;
        }

        .greeting {
            font-family: 'Sora', sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #0F2057;
            margin-bottom: 10px;
        }

        .intro {
            font-size: 14.5px;
            line-height: 1.7;
            color: #4A5578;
            margin-bottom: 28px;
        }

        /* ── Success badge ── */
        .success-badge {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #ECFDF5;
            border: 1.5px solid #6EE7B7;
            border-radius: 10px;
            padding: 16px 20px;
            margin-bottom: 32px;
        }

        .badge-icon {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            background: #D1FAE5;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .badge-icon svg {
            width: 20px;
            height: 20px;
            fill: #059669;
        }

        .badge-text {
            font-size: 14px;
            line-height: 1.6;
            color: #065F46;
        }

        .badge-text strong {
            display: block;
            font-weight: 700;
            font-size: 14.5px;
            color: #064E3B;
            margin-bottom: 2px;
        }

        /* ── Tips ── */
        .tips-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: #8A94B2;
            margin-bottom: 14px;
        }

        .tips {
            margin-bottom: 32px;
        }

        .tip-row {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            padding: 12px 0;
            border-bottom: 1px solid #F1F5FF;
        }

        .tip-row:last-child {
            border-bottom: none;
        }

        .tip-icon {
            width: 32px;
            height: 32px;
            flex-shrink: 0;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 1px;
        }

        .tip-icon svg {
            width: 16px;
            height: 16px;
        }

        .ti-blue {
            background: #EBF2FF;
        }

        .ti-blue svg {
            fill: #3B82F6;
        }

        .ti-amber {
            background: #FFF7EA;
        }

        .ti-amber svg {
            fill: #F59E0B;
        }

        .ti-green {
            background: #EDFAF4;
        }

        .ti-green svg {
            fill: #10B981;
        }

        .tip-title {
            font-size: 13.5px;
            font-weight: 600;
            color: #0F2057;
            margin-bottom: 2px;
        }

        .tip-desc {
            font-size: 12.5px;
            color: #8A94B2;
            line-height: 1.55;
        }

        /* ── CTA ── */
        .cta-wrap {
            text-align: center;
            margin-bottom: 32px;
        }

        .cta-btn {
            display: inline-block;
            background: #0F2057;
            color: #ffffff !important;
            font-family: 'Sora', sans-serif;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            padding: 14px 36px;
            border-radius: 8px;
            letter-spacing: 0.2px;
        }

        .divider {
            border: none;
            border-top: 1px solid #E8EDF5;
            margin: 0 0 26px;
        }

        /* ── Alert ── */
        .alert-row {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            background: #FFF8F5;
            border-left: 3px solid #E05C2A;
            border-radius: 0 8px 8px 0;
            padding: 14px 16px;
        }

        .alert-icon {
            flex-shrink: 0;
            margin-top: 1px;
        }

        .alert-text {
            font-size: 13px;
            line-height: 1.6;
            color: #5A3820;
        }

        .alert-text strong {
            display: block;
            font-weight: 600;
            color: #3B1F0F;
            margin-bottom: 2px;
        }

        .alert-text a {
            color: #E05C2A;
            text-decoration: none;
            font-weight: 600;
        }

        /* ── Footer ── */
        .footer {
            background: #F5F7FC;
            border-radius: 0 0 12px 12px;
            padding: 24px 40px;
            border-top: 1px solid #E2E8F5;
            text-align: center;
        }

        .footer-text {
            font-size: 12px;
            color: #8A94B2;
            line-height: 1.7;
        }

        .footer-brand {
            font-weight: 600;
            color: #0F2057;
        }

        @media (max-width: 480px) {
            .wrapper {
                margin: 16px auto;
            }

            .header,
            .card,
            .footer {
                padding-left: 24px;
                padding-right: 24px;
            }

            .hero {
                padding: 32px 24px;
            }

            .hero-title {
                font-size: 20px;
            }
        }
    </style>
</head>

<body>
    <div class="wrapper">

        <!-- Header -->
        <div class="header">
            <div class="logo-mark">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-1.5 1.5L20.46 12H17V9.5h1.5zM6 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2.22-3c-.55-.61-1.33-1-2.22-1s-1.67.39-2.22 1H3V6h12v9H8.22zm9.78 3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z" />
                </svg>
            </div>
            <span class="logo-text">Parcel<span>Flow</span></span>
        </div>

        <!-- Hero -->
        <div class="hero">
            <div class="hero-icon-ring">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />
                </svg>
            </div>
            <h1 class="hero-title">Password Changed Successfully</h1>
            <p class="hero-sub">
                Your account is secured with your new password.<br />
                You can now log in to ParcelFlow.
            </p>
        </div>

        <!-- Card -->
        <div class="card">
            <p class="greeting">Well done, <%= name %>!</p>
            <p class="intro">
                Your ParcelFlow merchant account password has been updated successfully.
                This change took effect immediately. If you did not make this change,
                please contact our support team right away.
            </p>

            <!-- Success badge -->
            <div class="success-badge">
                <div class="badge-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" />
                    </svg>
                </div>
                <div class="badge-text">
                    <strong>Account secured</strong>
                    Password updated on <%= new Date().toLocaleDateString('en-US', { weekday: 'long' , year: 'numeric' ,
                        month: 'long' , day: 'numeric' }) %>
                </div>
            </div>

            <p class="tips-label">Keep your account safe</p>
            <div class="tips">

                <div class="tip-row">
                    <div class="tip-icon ti-blue">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                        </svg>
                    </div>
                    <div>
                        <p class="tip-title">Use a unique password</p>
                        <p class="tip-desc">Never reuse passwords across different websites or apps.</p>
                    </div>
                </div>

                <div class="tip-row">
                    <div class="tip-icon ti-amber">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M11.5 2C6.81 2 3 5.81 3 10.5S6.81 19 11.5 19h.5v3c4.86-2.34 8-7 8-11.5C20 5.81 16.19 2 11.5 2zm1 14.5h-2v-2h2v2zm0-4h-2c0-3.25 3-3 3-5 0-1.1-.9-2-2-2s-2 .9-2 2h-2c0-2.21 1.79-4 4-4s4 1.79 4 4c0 2.5-3 2.75-3 5z" />
                        </svg>
                    </div>
                    <div>
                        <p class="tip-title">Never share your password</p>
                        <p class="tip-desc">ParcelFlow will never ask for your password via email or chat.</p>
                    </div>
                </div>

                <div class="tip-row">
                    <div class="tip-icon ti-green">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                        </svg>
                    </div>
                    <div>
                        <p class="tip-title">Log out on shared devices</p>
                        <p class="tip-desc">Always sign out after using ParcelFlow on a public or shared device.</p>
                    </div>
                </div>

            </div>

            <div class="cta-wrap">
                <a href="https://parcelflow.com/login" class="cta-btn">Log In to ParcelFlow →</a>
            </div>

            <hr class="divider" />

            <div class="alert-row">
                <span class="alert-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="#E05C2A">
                        <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
                    </svg>
                </span>
                <div class="alert-text">
                    <strong>Wasn't you?</strong>
                    If you did not change your password, your account may be compromised.
                    <a href="mailto:support@parcelflow.com">Contact support immediately</a>
                    so we can secure your account.
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p class="footer-text">
                © <%= new Date().getFullYear() %> <span class="footer-brand">ParcelFlow</span>. All rights
                    reserved.<br />
                    Connecting merchants and riders across Bangladesh.<br />
                    <a href="https://parcelflow.com/privacy" style="color:#8A94B2; text-decoration:underline;">Privacy
                        Policy</a>
                    &nbsp;·&nbsp;
                    <a href="https://parcelflow.com/help" style="color:#8A94B2; text-decoration:underline;">Help
                        Center</a>
            </p>
        </div>

    </div>
</body>

</html>