# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL=YUR_POSTGRES_CONNECTION_STRING

NODE_ENV=YOUR_ENVIRONMENT
PORT=YOUR_PORT

JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=YOUR_JWT_ACCESS_EXPIRES_IN
JWT_REFRESH_EXPIRES_IN=YOUR_JWT_REFRESH_EXPIRES_IN

BCRYPT_SALT_ROUNDS=YOUR_BCRYPT_SALT_ROUNDS

# Used to build absolute links back to this API (not read anywhere yet).
BACKEND_URL=YOUR_BACKEND_URL

# Allowed CORS origin for the browser client.
FRONTEND_URL=YOUR_FRONTEND_URL

SUPER_ADMIN_NAME=YOUR_SUPER_ADMIN_NAME
SUPER_ADMIN_PASSWORD=YOUR_SUPER_ADMIN_PASSWORD
SUPER_ADMIN_EMAIL=YOUR_SUPER_ADMIN_EMAIL

TESTER_ADMIN_NAME=YOUR_TESTER_ADMIN_NAME
TESTER_ADMIN_PASSWORD=YOUR_TESTER_ADMIN_PASSWORD
TESTER_ADMIN_EMAIL=YOUR_TESTER_ADMIN_EMAIL

TESTER_RIDER_NAME=YOUR_TESTER_RIDER_NAME
TESTER_RIDER_EMAIL=YOUR_TESTER_RIDER_EMAIL
TESTER_RIDER_PASSWORD=YOUR_TESTER_RIDER_PASSWORD

REDIS_USER=YOUR_REDIS_USER
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=YOUR_REDIS_PORT

SMTP_USER=YOUR_SMTP_USER
EMAIL_SENDER=YOUR_EMAIL_SENDER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

BKASH_BASE_URL=YOUR_BKASH_BASE_URL
BKASH_USERNAME=YOUR_BKASH_USERNAME
BKASH_PASSWORD=YOUR_BKASH_PASSWORD
BKASH_APP_KEY=YOUR_BKASH_APP_KEY
BKASH_APP_SECRET=YOUR_BKASH_APP_SECRET
BKASH_CALLBACK_URL=YOUR_BKASH_CALLBACK_URL